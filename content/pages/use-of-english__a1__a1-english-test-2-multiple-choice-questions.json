nsive. </div>","choices":[{"id":7088,"letter":"A.","html":"<span>Anna's car</span>"},{"id":7089,"letter":"B.","html":"<span>the car of Anna</span>"},{"id":7090,"letter":"C.","html":"<span>Anna car</span>"}]},{"id":4668,"num":"6","type":"radio","prompt":"<div>_____ summer, I get up early _____ Sunday mornings. </div>","choices":[{"id":7091,"letter":"A.","html":"<span>In/in</span>"},{"id":7092,"letter":"B.","html":"<span>At/on</span>"},{"id":7093,"letter":"C.","html":"<span>In/on</span>"}]},{"id":4669,"num":"7","type":"radio","prompt":"<div>Please, can you stop making noise? I _____ a book. </div>","choices":[{"id":7094,"letter":"A.","html":"<span>'m reading</span>"},{"id":7095,"letter":"B.","html":"<span>read</span>"},{"id":7096,"letter":"C.","html":"<span>reading</span>"}]},{"id":4670,"num":"8","type":"radio","prompt":"<div>When _____?</div>","choices":[{"id":7097,"letter":"A.","html":"<span>they arrived</span>"},{"id":7098,"letter":"B.","html":"<span>did they arrived</span>"},{"id":7099,"letter":"C.","html":"<span>did they arrive</span>"}]},{"id":4671,"num":"9","type":"radio","prompt":"<div>Does he have _____?</div>","choices":[{"id":7100,"letter":"A.","html":"<span>any sisters</span>"},{"id":7101,"letter":"B.","html":"<span>any sister</span>"},{"id":7102,"letter":"C.","html":"<span>some sisters</span>"}]},{"id":4672,"num":"10","type":"radio","prompt":"<div>What _____ tomorrow?</div>","choices":[{"id":7103,"letter":"A.","html":"<span>will you do</span>"},{"id":7104,"letter":"B.","html":"<span>do you do</span>"},{"id":7105,"letter":"C.","html":"<span>are you going to do</span>"}]},{"id":4673,"num":"11","type":"radio","prompt":"<div>_____ sugar do you want in your tea?</div>","choices":[{"id":7106,"letter":"A.","html":"<span>How much</span>"},{"id":7107,"letter":"B.","html":"<span>How many</span>"},{"id":7108,"letter":"C.","html":"<span>What </span>"}]},{"id":4674,"num":"12","type":"radio","prompt":"<div>Peter is _____ player in the team. </div>","choices":[{"id":710