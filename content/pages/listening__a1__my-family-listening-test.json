pan>True</span>"},{"id":9859,"letter":"B.","html":"<span>False</span>"}]},{"id":5907,"num":"6","type":"radio","prompt":"<div>James rarely sees his cousin George these days.</div>","choices":[{"id":9860,"letter":"A.","html":"<span>True</span>"},{"id":9861,"letter":"B.","html":"<span>False</span>"}]},{"id":5908,"num":"7","type":"radio","prompt":"<div>George is more serious and more active than James.</div>","choices":[{"id":9862,"letter":"A.","html":"<span>True</span>"},{"id":9863,"letter":"B.","html":"<span>False</span>"}]},{"id":5909,"num":"8","type":"radio","prompt":"<div>George and James never talk about their problems together.</div>","choices":[{"id":9864,"letter":"A.","html":"<span>True</span>"},{"id":9865,"letter":"B.","html":"<span>False</span>"}]}]}]}