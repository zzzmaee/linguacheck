ype":"radio","prompt":"<div>Why does Deb write a blog?</div>","choices":[{"id":15071,"letter":"A.","html":"<span>To promote her exciting lifestyle</span>"},{"id":15072,"letter":"B.","html":"<span>To let friends know what she's doing</span>"},{"id":15073,"letter":"C.","html":"<span>To express her personal feelings</span>"}]},{"id":8579,"num":"5","type":"radio","prompt":"<div>What does Deb miss about living in a flat?</div>","choices":[{"id":15074,"letter":"A.","html":"<span>having many possessions</span>"},{"id":15075,"letter":"B.","html":"<span>having hot baths</span>"},{"id":15076,"letter":"C.","html":"<span>doing chores easily</span>"}]},{"id":8580,"num":"6","type":"radio","prompt":"<div>What does Deb like about her lifestyle?</div>","choices":[{"id":15077,"letter":"A.","html":"<span>Having more free time</span>"},{"id":15078,"letter":"B.","html":"<span>Being close to nature</span>"},{"id":15079,"letter":"C.","html":"<span>Exploring different places</span>"}]}]}]}