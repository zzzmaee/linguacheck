{"id":16818,"path":"/listening/a1/schools-in-britain-listening-test/","parentId":1138,"order":995,"section":"listening","level":"a1","depth":3,"title":"Schools in Britain – A1 English Listening Test","seo":{"title":"Schools in Britain - A1 English Listening Test - Test-English","description":"Listening comprehension practice test for beginners and elementary students (CEFR A1 level). Schools and education.","image":"/media/uploads/CEFR-A1-listening_Schools-Britain.jpg"},"modified":"2025-06-05T10:01:36","kind":"lesson","parts":["<h3>A1 English Listening Test</h3> <h5>Watch a video about schools in Britain. For questions 1 to 7, choose the correct answer.</h5> <p></p> <div class=\"videoWrapper\"> <div data-youtube=\"HwrC8oCdpQY\"></div> </div> <h6>For more videos like this, go to <a href=\"https://www.youtube.com/playlist?list=PL59GcrPDHI8KRjnxslMF13wbOQ8Uyb5Oh\">Loescher Editore video</a></h6> <div class=\"list-separator-dots\"><span>Questions</span></div> <div data-quiz=\"635\"></div>"],"explanation":null,"quizzes":[{"id":635,"questions":[{"id":5480,"num":"1","type":"radio","prompt":"<div>Children arrive at school ...</div>","choices":[{"id":8483,"letter":"A.","html":"<span>by car.</span>"},{"id":8484,"letter":"B.","html":"<span>by bus.</span>"},{"id":8485,"letter":"C.","html":"<span>by different means of transportation.</span>"}]},{"id":5481,"num":"2","type":"radio","prompt":"<div>Children ...</div>","choices":[{"id":8486,"letter":"A.","html":"<span>arrive at school at 9 o'clock.</span>"},{"id":8487,"letter":"B.","html":"<span>are sometimes late for school.</span>"},{"id":8488,"letter":"C.","html":"<span>sometimes play football before school starts. </span>"}]},{"id":5482,"num":"3","type":"radio","prompt":"<div>In this school boys and girls ...</div>","choices":[{"id":8489,"letter":"A.","html":"<span>wear the same uniform.</span>"},{"id":8490,"letter":"B.","html":"<span>go to separate classrooms.</span>"},{"id":8491,"letter":"C.","html":"<span>wear similar clothes. </span>"}]},{"id":5483,"num":"4","type":"radio","prompt":"<div>Students ...</div>","choices":[{"id":8492,"letter":"A.","html":"<span>keep their bags in lockers.</span>"},{"id":8493,"letter":"B.","html":"<span>keep their books in their school bags or lockers.</span>"},{"id":8494,"letter":"C.","html":"<span>use lockers for books and clothes. </span>"}]},{"id":5484,"num":"5","type":"radio","prompt":"<div>The Principal is ...</div>","choices":[{"id":8495,"letter":"A.","html":"<span>another name for Headteacher.</span>"},{"id":8496,"letter":"B.","html":"<span>a secretary.</span>"},{"id":8497,"letter":"C.","html":"<span>an important place in the school.</span>"}]},{"id":5485,"num":"6","type":"radio","prompt":"<div>All the schools in Britain ...</div>","choices":[{"id":8498,"letter":"A.","html":"<span>study the same subjects. </span>"},{"id":8499,"letter":"B.","html":"<span>have different curriculums for the same subjects.</span>"},{"id":8500,"letter":"C.","html":"<span>have computer rooms. </span>"}]},{"id":5486,"num":"7","type":"radio","prompt":"<div>The staff room is the place where ... </div>","choices":[{"id":8501,"letter":"A.","html":"<span>students make new friends. </span>"},{"id":8502,"letter":"B.","html":"<span>teachers work.</span>"},{"id":8503,"letter":"C.","html":"<span>teachers relax.</span>"}]}]}]}