/span>"},{"id":9839,"letter":"B.","html":"<span>False</span>"}]},{"id":5897,"num":"6","type":"radio","prompt":"<div>Sarah keeps her bike in a space opposite a toilet.</div>","choices":[{"id":9840,"letter":"A.","html":"<span>True</span>"},{"id":9841,"letter":"B.","html":"<span>False</span>"}]},{"id":5898,"num":"7","type":"radio","prompt":"<div>Sara's sofa is cheap and comfortable.</div>","choices":[{"id":9842,"letter":"A.","html":"<span>True</span>"},{"id":9843,"letter":"B.","html":"<span>False</span>"}]},{"id":5899,"num":"8","type":"radio","prompt":"<div>Her kitchen is big and has a view of the sea.</div>","choices":[{"id":9844,"letter":"A.","html":"<span>True</span>"},{"id":9845,"letter":"B.","html":"<span>False</span>"}]},{"id":5900,"num":"9","type":"radio","prompt":"<div>The bathroom is opposite the kitchen.</div>","choices":[{"id":9846,"letter":"A.","html":"<span>True</span>"},{"id":9847,"letter":"B.","html":"<span>False</span>"}]},{"id":5901,"num":"10","type":"radio","prompt":"<div>Her living room is tidier than her bedroom.</div>","choices":[{"id":9848,"letter":"A.","html":"<span>True</span>"},{"id":9849,"letter":"B.","html":"<span>False</span>"}]}]}]}