"}]},{"id":5542,"num":"4","type":"radio","prompt":"<div>Which sentence is correct?</div>","choices":[{"id":8653,"letter":"A.","html":"<span>'Lager' is red beer and 'stout' is black beer. </span>"},{"id":8654,"letter":"B.","html":"<span>'Bitter' is red beer and 'Guinness' is black beer.</span>"},{"id":8655,"letter":"C.","html":"<span>Blond beer is called 'lager' or 'ale'.</span>"}]},{"id":5543,"num":"5","type":"radio","prompt":"<div>Drinks ...</div>","choices":[{"id":8658,"letter":"A.","html":"<span>are the same price sitting at a table or standing at the bar.</span>"},{"id":8657,"letter":"B.","html":"<span>are cheaper in the afternoon.</span>"},{"id":8656,"letter":"C.","html":"<span>are more expensive if you sit at a table.</span>"}]},{"id":5544,"num":"6","type":"radio","prompt":"<div>You can order food...</div>","choices":[{"id":8661,"letter":"A.","html":"<span>in most pubs.</span>"},{"id":8660,"letter":"B.","html":"<span>but you pay for the food and the service. </span>"},{"id":8659,"letter":"C.","html":"<span>but it's sometimes expensive. </span>"}]},{"id":5545,"num":"7","type":"radio","prompt":"<div>Smoking...</div>","choices":[{"id":8662,"letter":"A.","html":"<span>is allowed outside. </span>"},{"id":8664,"letter":"B.","html":"<span>is allowed in special rooms.</span>"},{"id":8663,"letter":"C.","html":"<span>was recently prohibited. </span>"}]}]}]}