iv>","choices":[{"id":4521,"letter":"A.","html":"<span>At 11.00.</span>"},{"id":4522,"letter":"B.","html":"<span>At 12.00.</span>"},{"id":4523,"letter":"C.","html":"<span>At 12.40.</span>"}]},{"id":2668,"num":"5","type":"radio","prompt":"<div>Where does he have lunch?</div>","choices":[{"id":4524,"letter":"A.","html":"<span>In the town centre.</span>"},{"id":4525,"letter":"B.","html":"<span>At the school.</span>"},{"id":4526,"letter":"C.","html":"<span>At home.</span>"}]},{"id":2669,"num":"6","type":"radio","prompt":"<div>What does he think about school food?</div>","choices":[{"id":4527,"letter":"A.","html":"<span>It isn't good.</span>"},{"id":4528,"letter":"B.","html":"<span>It's good.</span>"},{"id":4529,"letter":"C.","html":"<span>It's very good.</span>"}]},{"id":2670,"num":"7","type":"radio","prompt":"<div>What does he do when he arrives home?</div>","choices":[{"id":4530,"letter":"A.","html":"<span>He relaxes. </span>"},{"id":4531,"letter":"B.","html":"<span>He helps his mum.</span>"},{"id":4532,"letter":"C.","html":"<span>He has dinner.</span>"}]}]}]}